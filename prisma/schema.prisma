generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  walletAddress String?   @unique
  email         String?   @unique
  name          String?
  corretor      Corretor?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Corretor {
  id               Int          @id @default(autoincrement())
  corretorId       String       @unique
  userId           Int          @unique
  user             User         @relation(fields: [userId], references: [id])

  nome             String?
  cpf              String?
  endereco         Json?
  creci            String?
  dadosBancarios   Json?
  instagramHandle  String?      @unique

  saldoDisponivel  Float        @default(0)
  saldoPendente    Float        @default(0)

  statusCertificacao String?    @map("statuscertificacao")

  vendas           Venda[]
  saques           Saque[]
  indicacoes       Indicacao[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Indicacao {
  id          Int       @id @default(autoincrement())
  accountId   String
  consultorId Int
  corretor    Corretor  @relation(fields: [consultorId], references: [id])
  status      String    @default("pendente") // pendente | comprado
  createdAt   DateTime  @default(now())
}

model Venda {
  id         Int       @id @default(autoincrement())
  vendaId    String    @unique
  corretorId Int
  corretor   Corretor  @relation(fields: [corretorId], references: [id])
  imovelId   String?
  valor      Float
  comissao   Float
  status     String    @default("pendente")
  dataVenda  DateTime?
  createdAt  DateTime  @default(now())
}

model Saque {
  id             Int      @id @default(autoincrement())
  corretorId     Int
  corretor       Corretor @relation(fields: [corretorId], references: [id])
  valor          Float
  dadosBancarios Json?
  status         String   @default("pendente")
  createdAt      DateTime @default(now())
}
